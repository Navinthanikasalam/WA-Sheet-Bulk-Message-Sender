{
  "manifest_version": 3,
  "name": "WA Sheet \u2013 WhatsApp Bulk Sender",
  "version": "1.2.0",
  "description": "Send bulk WhatsApp messages from Manual Entry, Excel, CSV, or Google Sheets \u2014 automated through WhatsApp Web.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WA Sheet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/xlsx.full.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
